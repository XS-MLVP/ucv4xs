+// Verilator VlWide uses little-endian, 32-bit words. Keep the parent and
+// slice alive in the engine; reading the slice refreshes native parent storage.
+XData* ExprEngine::GetOrCreateSignalWord(XSignalCFG* cfg, const std::string &name, uint64_t word){
+    XData *parent = GetOrCreateSignal(cfg, name);
+    const uint64_t width = parent->W();
+    if(width <= 64 || word >= (width + 31) / 32){
+        throw std::runtime_error("invalid wide signal word: " + name + "[" + std::to_string(word) + "]");
+    }
+    const std::string key = name + "[" + std::to_string(word) + "]";
+    auto found = signal_xdata.find(key);
+    if(found != signal_xdata.end()) return found->second.get();
+    const uint32_t start = static_cast<uint32_t>(word * 32);
+    const uint32_t count = static_cast<uint32_t>(std::min<uint64_t>(32, width - start));
+    auto slice = std::unique_ptr<XData>(parent->SubDataRefRaw(start, count, key));
+    XData *result = slice.get();
+    signal_xdata[key] = std::move(slice);
+    return result;
+}
