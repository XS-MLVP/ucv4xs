+bool append_declarations(const std::vector<std::string> &files, std::vector<trace_event> &events)
+{
+    std::map<std::string, std::string> bodies;
+    const std::regex definition(R"(void\s+(\w+__trace_init_sub\w*)\s*\([^;{]*\)\s*\{)");
+    const std::regex call(R"((\w+__trace_init_sub\w*)\s*\(vlSelf,\s*tracep\))");
+    for (const auto &file : files) {
+        auto text = read_file(file);
+        for (auto it = std::sregex_iterator(text.begin(), text.end(), definition); it != std::sregex_iterator(); ++it) {
+            size_t begin = it->position() + it->length(), end = begin;
+            int depth = 1;
+            bool quoted = false, escaped = false;
+            for (; end < text.size() && depth; ++end) {
+                const char ch = text[end];
+                if (quoted) {
+                    if (escaped) escaped = false;
+                    else if (ch == '\\') escaped = true;
+                    else if (ch == '"') quoted = false;
+                } else if (ch == '"') quoted = true;
+                else if (ch == '{') ++depth;
+                else if (ch == '}') --depth;
+            }
+            if (depth) PK_FATAL("Unterminated trace initialization function");
+            bodies.emplace((*it)[1].str(), text.substr(begin, end - begin - 1));
+        }
+    }
+    if (bodies.empty()) return false;
+    std::set<std::string> called, active, visited;
+    for (const auto &[name, body] : bodies)
+        for (auto it = std::sregex_iterator(body.begin(), body.end(), call); it != std::sregex_iterator(); ++it)
+            called.insert((*it)[1].str());
+    std::vector<std::string> scope;
+    std::function<void(const std::string &)> visit = [&](const std::string &name) {
+        if (!bodies.count(name) || active.count(name)) PK_FATAL("Invalid trace initialization call: %s", name.c_str());
+        active.insert(name); visited.insert(name);
+        for (const auto &statement : split_statements(bodies.at(name))) {
+            std::vector<std::string> args;
+            std::smatch match;
+            if (unwrap_call_args(statement, "VL_TRACE_PUSH_PREFIX", args)) {
+                if (args.size() < 2) PK_FATAL("Invalid trace prefix");
+                scope.push_back(strip_quotes(args[1]));
+            } else if (statement.find("VL_TRACE_POP_PREFIX") != std::string::npos) {
+                if (scope.empty()) PK_FATAL("Trace prefix stack underflow");
+                scope.pop_back();
+            } else if (std::regex_search(statement, match, call)) {
+                visit(match[1].str());
+            } else if (statement.find("VL_TRACE_DECL_") != std::string::npos && unwrap_call_args(statement, "VL_TRACE_DECL_", args)) {
+                trace_event event;
+                if (parse_decl(statement, args, event)) {
+                    event.name = join_scope(scope, event.name);
+                    events.push_back(std::move(event));
+                }
+            }
+        }
+        active.erase(name);
+    };
+    for (const auto &[name, body] : bodies) if (!called.count(name)) {
+        if (!scope.empty()) PK_FATAL("Unbalanced trace initialization root");
+        visit(name);
+        if (!scope.empty()) PK_FATAL("Unbalanced trace initialization root");
+    }
+    if (visited.size() != bodies.size()) PK_FATAL("Unreachable trace initialization function");
+    return true;
+}
+
